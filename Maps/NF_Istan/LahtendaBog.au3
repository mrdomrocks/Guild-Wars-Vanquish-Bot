Func GoOutLahtendaBog()
        Local $aGoOutRoute[4][2] = [ [1873, -460] _
                , [227, -3402] _
                , [298, -4114] _
                , [298, -4500] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "LahtendaBog exit ")
EndFunc

