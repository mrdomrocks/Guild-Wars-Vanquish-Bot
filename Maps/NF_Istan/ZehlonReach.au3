Func GoOutZehlonReach()
        Local $aGoOutRoute[4][2] = [ [3511, 1930] _
                , [4225, 4510] _
                , [4455, 4479] _
                , [4550, 4479] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "ZehlonReach exit ")
EndFunc

Func VQZehlonReach()
    If GetMapID() <> $ZehlonReach_Map And GetMapID() <> $ZehlonReach_Outpost  Then TravelTo($ZehlonReach_Outpost)   
    If GetMapID() = $ZehlonReach_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $ZehlonReach_Map Then    
		



		
		
		GoNearestNPCToCoords(-18642, -18011)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Istan_ZehlonReachRoute01)
		
		GoNearestNPCToCoords(-17092, 10583)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
