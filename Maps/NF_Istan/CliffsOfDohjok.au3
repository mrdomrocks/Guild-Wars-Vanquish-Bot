Func GoOutCliffsOfDohjok()
        Local $aGoOutRoute[3][2] = [ [2572, 1621] _
                , [4300, 4564] _
                , [4400, 4590] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "CliffsOfDohjok exit ")
EndFunc

