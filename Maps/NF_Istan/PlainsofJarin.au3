Func GoOutPlainsofJarin()
        Local $aGoOutRoute[2][2] = [ [-9259, 16725] _
                , [-9300, 17000] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "PlainsofJarin exit ")
EndFunc

