Func GoOutIssnurIsles()
        Local $aGoOutRoute[2][2] = [ [-16011, 11304] _
                , [-15700, 11304] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "IssnurIsles exit ")
EndFunc

