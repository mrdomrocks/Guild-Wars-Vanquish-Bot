Func GoOutMehtaniKeys()
        Local $aGoOutRoute[4][2] = [ [303, -1560] _
                , [3926, -3966] _
                , [4286, -3765] _
                , [4500, -3765] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "MehtaniKeys exit ")
EndFunc

