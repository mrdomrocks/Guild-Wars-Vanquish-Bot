Func GoOutFahranurTheFirstCity()
        Local $aGoOutRoute[5][2] = [ [-3232, 3400] _
                , [-4316, 4419] _
                , [-4380, 4557] _
                , [-4405, 4603] _
                , [-4505, 4803] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "FahranurTheFirstCity exit ")
EndFunc

