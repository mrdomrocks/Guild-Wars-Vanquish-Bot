;Mapped by Crux
#include <Array.au3>
Global $vqrange = 1450
Global $ActionCounter = 1

Local $aSacnothValleyOutpostPath[1][2] = [ _
	[-15660, 13968]]

Local $aSacnothValleyTransitPath[18][2] = [ _
	[-14310, 12724], _
	[-11786, 12509], _
	[-10014, 10738], _
	[-8248, 8896], _
	[-6405, 7167], _
	[-4532, 5433], _
	[-2409, 4044], _
