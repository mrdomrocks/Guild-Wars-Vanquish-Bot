Func GoOutRivenEarth()
        Local $aGoOutRoute[2][2] = [ [19623, 16850] _
                , [20300, 16850] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "RivenEarth exit ")
EndFunc

Func VQRivenEarth()
	If GetMapID() <> $RivenEarth_Map And GetMapID() <> $RivenEarth_Outpost Then
		_Vanquisher_ResetGoOutRouteProgress()
		CurrentAction("Traveling to outpost for Riven Earth.")
		TravelTo($RivenEarth_Outpost)
	EndIf

	If GetMapID() = $RivenEarth_Outpost Then
		_Vanquisher_ApplyDifficulty()
		GoOut()
		If GetMapID() <> $RivenEarth_Map Then
			CurrentAction("Routing - on map " & GetMapID() & ", need Riven Earth (" & $RivenEarth_Map & ").")
			Return
		EndIf
	EndIf

	If GetMapID() <> $RivenEarth_Map Then
		CurrentAction("Riven Earth route waiting - on map " & GetMapID() & ", need " & $RivenEarth_Map & ".")
		Return
	EndIf

	CurrentAction("Starting Riven Earth vanquish route.")


	GoNearestNPCToCoords(18766, 15933)
	Sleep(1000)
	Dialog(0x83)
	Sleep(1000)
	Dialog(0x84)
	Sleep(1000)

	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute01)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute02)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute03)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute04)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute05)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute06)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute07)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute08)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute09)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute10)

	; reverse
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute11)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute12)
	; shrine
	_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_RivenEarthRoute13)
	; shrine
