Func GoOutArborBay()
        Local $aGoOutRoute[2][2] = [ [16129.67, 14160.49] _
                , [15545.26, 12675.66] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "ArborBay exit ", 2000)
EndFunc

Func VQArborBay()

	;This block is to pick up blessings. Add NPC coords and the right dialogue
	GoNearestNPCToCoords(16362.00,11627.00)
	Sleep(1000)
	Dialog(0x84)
	Sleep(1000)
	Dialog(0x84)
	Sleep(1000)

Do

		$DeadOnTheRun = 0
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute01)
		If GetAreaVanquished() = False Then AggroMoveTo(11094.00 , -18167.49) ;Second Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute02)
		If GetAreaVanquished() = False Then AggroMoveTo(407.29 , -17736.69) ;Alitta Spawn
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute03)
		If GetAreaVanquished() = False Then AggroMoveTo(-16668.76 , -18866.15) ;Third Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute04)
		If GetAreaVanquished() = False Then AggroMoveTo(-15603.82 , -4775.26) ;Fourth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute05)
		If GetAreaVanquished() = False Then AggroMoveTo(-16516.73 , 9803.07) ;Fifth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute06)
		If GetAreaVanquished() = False Then AggroMoveTo(-3060.54 , 14263.56) ;Sixth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute07)
		If GetAreaVanquished() = False Then AggroMoveTo(11757.11 , 146.09) ;Seventh Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute08)
		If GetAreaVanquished() = False Then AggroMoveTo(-3955.05 , -10383.03) ;Eigth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute09)
		If GetAreaVanquished() = False Then AggroMoveTo(-16508.75 , 9732.01) ;Fifth Shrine Return
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute10)
		If GetAreaVanquished() = False Then AggroMoveTo(-3015.50 , -3015.50) ;Sixth Shrine Return
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute11)
		If GetAreaVanquished() = False Then AggroMoveTo(-16700.98 , 14449.31) ;Reverse start here
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute12)
		If GetAreaVanquished() = False Then AggroMoveTo(-3015.50 , -3015.50) ;Sixth Shrine Return
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute13)
		If GetAreaVanquished() = False Then AggroMoveTo(-16508.75 , 9732.01) ;Fifth Shrine Return
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute14)
		If GetAreaVanquished() = False Then AggroMoveTo(-3955.05 , -10383.03) ;Eighth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute15)
		If GetAreaVanquished() = False Then AggroMoveTo(11757.11 , 146.09) ;Seventh Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute16)
		If GetAreaVanquished() = False Then AggroMoveTo(-3060.54 , 14263.56) ;Sixth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute17)
		If GetAreaVanquished() = False Then AggroMoveTo(-16516.73 , 9803.07) ;Fifth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute18)
		If GetAreaVanquished() = False Then AggroMoveTo(-15603.82 , -4775.26) ;Fourth Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute19)
		If GetAreaVanquished() = False Then AggroMoveTo(-16668.76 , -18866.15) ;Third Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute20)
		If GetAreaVanquished() = False Then AggroMoveTo(407.29 , -17736.69) ;Alitta Spawn
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute21)
		If GetAreaVanquished() = False Then AggroMoveTo(11094.00 , -18167.49) ;Second Shrine
		_Vanquisher_RunVanquishRoute($aEOTN_TarnishedCoast_ArborBayRoute22)
		If  $DeadOnTheRun = 1 then RndSlp(15000)

	Until CheckArea(13048.00 , 10177.50, 1800000) ;30min leeway to close the bot
	MsgBox(48, "VQ DONE", "VQ should be finished. Please check manually and get your carto done. Close the bot or it will reset in 30min")
	Sleep(3600000) ;30min leeway to close the bot;30min leeway to close the bot

	If $DeadOnTheRun = 0 Then CurrentAction("Waiting to get reward")
	If $DeadOnTheRun = 0 Then Sleep(3000)
EndFunc