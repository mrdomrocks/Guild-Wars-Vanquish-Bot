Func GoOutMorostavTrail()
        Local $aGoOutRoute[5][2] = [ [-9715, -3376] _
                , [-11645, -5155] _
                , [-12065, -7488] _
                , [-13751.78, -7651.70] _
                , [-14045.97, -7854.88] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "MorostavTrail exit ", 0, "WaitMapLoading")
EndFunc

Func VQMorostavTrail()
    If GetMapID() <> $MorostavTrail_Map And GetMapID() <> $MorostavTrail_Outpost  Then TravelTo($MorostavTrail_Outpost)   
    If GetMapID() = $MorostavTrail_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $MorostavTrail_Map Then    


		GoNearestNPCToCoords(22109, 12076)
	If GetKurzickFaction() > GetLuxonFaction() Then
                Dialog(0x81)
                Sleep(1000)
                Dialog(0x2)
                Sleep(1000)
                Dialog(0x84)
	        Sleep(1000)
	        Dialog(0x86)
	        Sleep(1000)
        Else
                Dialog(0x85)
                Sleep(1000)
                Dialog(0x86)
                Sleep(1000)
        EndIf

		_Vanquisher_RunVanquishRoute($aFactions_EchovaldForest_MorostavTrailRoute01)
      		_Vanquisher_RunVanquishRoute($aFactions_EchovaldForest_MorostavTrailRoute02)
		
    EndIf
EndFunc