Func GoOutMourningVeilFalls()
        Local $aGoOutRoute[4][2] = [ [-290.18, 275.96] _
                , [-3076.34, 4103.19] _
                , [-4380.62, 4251.05] _
                , [-4559.24, 4608.69] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "MourningVeilFalls exit ")
EndFunc

