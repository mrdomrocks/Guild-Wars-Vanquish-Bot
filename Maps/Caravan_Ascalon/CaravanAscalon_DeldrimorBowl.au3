	If _Vanquisher_ShouldRunCaravanWaypoint() Then AggroMoveTo(6334, -16162)
	If _Vanquisher_ShouldRunCaravanWaypoint() Then AggroMoveTo(4450, -20112)
	If _Vanquisher_ShouldRunCaravanWaypoint() Then AggroMoveTo(620, -20291)
	If _Vanquisher_ShouldRunCaravanWaypoint() Then AggroMoveTo(-5595, -16954)
