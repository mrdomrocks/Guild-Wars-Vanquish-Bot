Func GoOutIceCliffChasms()
        Local $aGoOutRoute[2][2] = [ [1683, -1594] _
                , [4600, -27863] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "IceCliffChasms exit ")
EndFunc

Func VQIceCliffChasms()
    If GetMapID() <> $IceCliffChasms_Map And GetMapID() <> $IceCliffChasms_Outpost  Then TravelTo($IceCliffChasms_Outpost)   
    If  GetMapID() = $IceCliffChasms_Outpost then
        GoOut() 
      
    EndIf
	
	
	If GetMapID() = $IceCliffChasms_Map Then	

		GoNearestNPCToCoords(2879.37, -24541.61)	
		Sleep(300)
		Dialog(0x84)
		Sleep(300)		
		;Sleep(1000)
		;Dialog(0x84)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute01)
		; start near wurms
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute02)
		; wurm 1+2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute03)
		; wurm 3+4
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute04)
		; wurm 5,6,7
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute05)
		; wurm 8,9,10
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute06)
		; wurm end corner
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute07)
		; restart wurms?
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute08)
		; start leaving wurms
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute09)
		; wurm popups
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute10)
		; popping aloes in nook
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute11)
		; Nidbjorg (Norn 2)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute12)

		GoNearestNPCToCoords(2612.05, -15526.33)	;;; NORN 2 -- too little kills for dialogue
		;Sleep(1000)
		;Dialog(0x84)
		;Sleep(1000)
		;Dialog(0x84)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute13)
		; avalanch +pines
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute14)
		; popping aloes
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute15)
		; intersection bottom right
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute16)
		; Skjaldulf (Norn 3)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute17)
		
		GoNearestNPCToCoords(7050.52, -9481.91)	  ;;;NORN 3
		Sleep(300)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute18)
		; Ragnvald (Norn 4)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute19)

		GoNearestNPCToCoords(-7659.00, -2221.00)	;;;NORN 4	annoying one
		Sleep(300)		
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute20)
		; on the ice
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute21)
		; on ice 2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute22)
		; off ice
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute23)
		; mandragor toxic 1
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute24)
		; mandragor toxic 2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute25)
		; mand grp 2 toxic
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute26)
		; mand grp 2 toxic 2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute27)
		; mand toxic 3
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute28)
		; lake loop start
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute29)
		; wisp hopefully dead
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute30)
		; near first imps
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute31)
		; near imp as well
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute32)
		; defo on 1st imps
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute33)
		; back on land
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute34)
		; Ogg the Gruff (Norn 5)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute35)
		
		GoNearestNPCToCoords(3777.12, 5122.87)	;NORN5
		Sleep(300)		
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute36)
		; near boss 'johon oxflinger'
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute37)
		; corner for same boss
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute38)
		; stonewolf intersection
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute39)
		; Oronoloff (Norn 6)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute40)
		
		GoNearestNPCToCoords(5388.23, 12130.31)		;NORN6
		Sleep(300)		
		; north-east wall
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute41)
		; SAFE BEFORE frozen elementals
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute42)
		; eles grp 1
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute43)
		; ele grp 1 -- 2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute44)
		; ele grp 2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute45)
		; ele grp 2 -- 2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute46)
		; boss loop 1
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute47)
		; boss loop 2
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute48)
		; boss 3
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute49)
		; boss 4
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute50)
		; mid
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute51)
		; mid 2 // ele grp
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute52)
		; Maddi (Norn 7)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute53)

		GoNearestNPCToCoords(10374.67, 25167.26)		;NORN7
		Sleep(300)		
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute54)
		; big run
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute55)
		; Kettibiron (Norn 8)
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute56)

		GoNearestNPCToCoords(-2357.00, 23514.85)		;NORN8
		Sleep(300)		
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute57)
		; start of lane
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute58)
		; safef lane at imps
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute59)
		; far side of 'ornoloff' again
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute60)
		; end?
		_Vanquisher_RunVanquishRoute($aEOTN_FarShiverpeaks_IceCliffChasmsRoute61)
    EndIf
EndFunc

