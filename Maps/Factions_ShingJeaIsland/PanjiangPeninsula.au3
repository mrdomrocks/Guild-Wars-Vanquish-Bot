#include <Array.au3>
Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutPanjiangPeninsula()
        Local $aGoOutRoute[2][2] = [ [-11001, -16229] _
                , [-11501, -17229] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "PanjiangPeninsula exit ")
EndFunc

