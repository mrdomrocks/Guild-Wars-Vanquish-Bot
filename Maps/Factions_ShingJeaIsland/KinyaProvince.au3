#include <Array.au3>
Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutKinyaProvince()
        Local $aGoOutRoute[2][2] = [ [14956, 15878] _
                , [14800, 15000] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "KinyaProvince exit ")
EndFunc

Func VQKinyaProvince()
