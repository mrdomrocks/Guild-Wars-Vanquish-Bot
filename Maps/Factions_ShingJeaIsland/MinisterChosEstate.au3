Func GoOutMinisterChosEstate()
        Local $aGoOutRoute[2][2] = [ [16642, 19493] _
                , [16995, 19739] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "MinisterChosEstate exit ")
EndFunc

