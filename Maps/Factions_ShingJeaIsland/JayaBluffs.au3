Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutJayaBluffs()
        Local $aGoOutRoute[5][2] = [ [18334, 11324] _
                , [19140, 13382] _
                , [18304, 14969] _
                , [17377, 17188] _
                , [16800, 17550] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "JayaBluffs exit ")
EndFunc

