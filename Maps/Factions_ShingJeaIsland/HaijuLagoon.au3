#include <Array.au3>
Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutHaijuLagoon()
        Local $aGoOutRoute[2][2] = [ [18839, 13668] _
                , [19100, 14100] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "HaijuLagoon exit ")
EndFunc

