Func GoOutSunquaVale()
        Local $aGoOutRoute[3][2] = [ [-11086, 10149] _
                , [-13860, 10410] _
                , [-15200, 11510] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "SunquaVale exit ")
EndFunc

