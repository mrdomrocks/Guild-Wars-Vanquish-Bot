Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutZenDaijun()
        Local $aGoOutRoute[1][2] = [ [19571.55, 9977.90] ]

        _Vanquisher_RunPathfinderRoute($aGoOutRoute, $vqrange, "ZenDaijun exit ")
        GoNearestNPCToCoords(20290.98, 9131.50)
        Sleep(1000)
        Dialog(0x7F)
        Dialog(0x800009)
        Dialog(0x80000B)
        Sleep(1000)
         WaitMapLoading($ZenDaijun_Map, 30000)
EndFunc

Func VQZenDaijun()
