Func GoOutWildernessOfBahdza()
        Local $aGoOutRoute[3][2] = [ [4537, 1365] _
                , [4783, 1220] _
                , [4983, 1220] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "WildernessOfBahdza exit ")
EndFunc

