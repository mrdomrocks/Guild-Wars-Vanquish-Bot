Func GoOutHoldingsOfChokhin()
        Local $aGoOutRoute[3][2] = [ [4, 2715] _
                , [-386, 4527] _
                , [-450, 4530] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "HoldingsOfChokhin exit ")
EndFunc

