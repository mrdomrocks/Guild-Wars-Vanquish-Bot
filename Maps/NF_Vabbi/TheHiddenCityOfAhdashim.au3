#include <Array.au3>
Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutTheHiddenCityOfAhdashim()
        Local $aGoOutRoute[1][2] = [ [1387, -20884] ]

        _Vanquisher_RunPathfinderRoute($aGoOutRoute, $vqrange, "TheHiddenCityOfAhdashim exit ")
        GoNearestNPCToCoords(1339, -20418)
        Sleep(1000)
        Dialog(0x00000081)
        Dialog(0x00000084)
        Sleep(1000)
        WaitForLoad()
EndFunc

