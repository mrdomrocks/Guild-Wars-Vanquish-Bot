Func GoOutVehtendiValley()
        Local $aGoOutRoute[5][2] = [ [-1564, -2064] _
                , [2447, -2438] _
                , [2520, -4458] _
                , [4337, -4834] _
                , [4550, -4834] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "VehtendiValley exit ")
EndFunc

Func VQVehtendiValley()
    If GetMapID() <> $VehtendiValley_Map And GetMapID() <> $VehtendiValley_Outpost  Then TravelTo($VehtendiValley_Outpost)   
    If GetMapID() = $VehtendiValley_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $VehtendiValley_Map Then   
	


		
		
		
		GoNearestNPCToCoords(-7552, 18559)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_VehtendiValleyRoute01)
		
		GoNearestNPCToCoords(9883, 13547)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_VehtendiValleyRoute02)
		
		GoNearestNPCToCoords(-13485, -17893)
		Sleep(1000)
		Dialog(0x83)
		RndSleep(1000)
		Dialog(0x85)
		RndSleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_VehtendiValleyRoute03)
		
		GoNearestNPCToCoords(12380, -15979)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		Sleep(20000)
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_VehtendiValleyRoute04)
		
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_VehtendiValleyRoute05)
		
    EndIf
EndFunc
