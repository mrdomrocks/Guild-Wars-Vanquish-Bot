Func GoOutYatendiCanyons()
        Local $aGoOutRoute[3][2] = [ [-1846, 920] _
                , [-4616, -1382] _
                , [-4850, -1388] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "YatendiCanyons exit ")
EndFunc

