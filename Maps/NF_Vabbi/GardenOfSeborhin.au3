Func GoOutGardenOfSeborhin()
        Local $aGoOutRoute[3][2] = [ [-1896, 14429] _
                , [-2029, 14479] _
                , [-2100, 14479] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "GardenOfSeborhin exit ")
EndFunc

Func VQGardenOfSeborhin()
    If GetMapID() <> $GardenOfSeborhin_Map And GetMapID() <> $GardenOfSeborhin_Outpost  Then TravelTo($GardenOfSeborhin_Outpost)   
    If GetMapID() = $GardenOfSeborhin_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $ForumHighlands_Map Then 



		
	
		GoNearestNPCToCoords(-4495, 15817)
		Sleep(1000)
		Dialog(0x00000081)
		Dialog(0x00000084)
		Sleep(5000)		
                  WaitMapLoading($GardenOfSeborhin_Map, 30000)
		
		GoNearestNPCToCoords(3960, -14652)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_GardenOfSeborhinRoute01)
		
		GoNearestNPCToCoords(8315, -949)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_GardenOfSeborhinRoute02)
		
		GoNearestNPCToCoords(8291, 4364)
		Sleep(1000)
		Dialog(0x83)
		RndSleep(1000)
		Dialog(0x85)
		RndSleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_GardenOfSeborhinRoute03)
		
		_Vanquisher_RunVanquishRoute($aNF_Vabbi_GardenOfSeborhinRoute04)
		
    EndIf
EndFunc
