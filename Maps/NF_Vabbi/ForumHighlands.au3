Func GoOutForumHighlands()
        Local $aGoOutRoute[2][2] = [ [4572, -4533] _
                , [4772, -4533] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "ForumHighlands exit ")
EndFunc

