Func GoOutVehjinMines()
        Local $aGoOutRoute[4][2] = [ [-2259, -78] _
                , [-4384, -2575] _
                , [-4544, -2571] _
                , [-4684, -2571] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "VehjinMines exit ")
EndFunc

