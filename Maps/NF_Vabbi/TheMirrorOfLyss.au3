Func GoOutTheMirrorOfLyss()
        Local $aGoOutRoute[4][2] = [ [-3336, 1102] _
                , [-891, 4438] _
                , [-884, 4509] _
                , [-883.08, 4698.31] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "TheMirrorOfLyss exit ")
EndFunc

