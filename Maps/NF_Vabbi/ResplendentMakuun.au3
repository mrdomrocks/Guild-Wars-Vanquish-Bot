Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutResplendentMakuun()
        Local $aGoOutRoute[4][2] = [ [-16849, 15501] _
                , [-18803, 14777] _
                , [-18745, 13593] _
                , [-18700, 13593] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "ResplendentMakuun exit ")
EndFunc

