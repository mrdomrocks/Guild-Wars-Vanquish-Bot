Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutMountQinkai()
        Local $aGoOutRoute[2][2] = [ [-5206, 13154] _
                , [-5600, 14000] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "MountQinkai exit ")
EndFunc

Func VQMountQinkai()
    If GetMapID() <> $MountQinkai_Map And GetMapID() <> $MountQinkai_Outpost  Then TravelTo($MountQinkai_Outpost)   
    If GetMapID() = $MountQinkai_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $MountQinkai_Map Then    

		
		GoNearestNPCToCoords(-8380, -9818)
	If GetKurzickFaction() > GetLuxonFaction() Then
                Dialog(0x81)
                Sleep(1000)
                Dialog(0x2)
                Sleep(1000)
                Dialog(0x84)
	        Sleep(1000)
	        Dialog(0x86)
	        Sleep(1000)
        Else
                Dialog(0x85)
                Sleep(1000)
                Dialog(0x86)
                Sleep(1000)
