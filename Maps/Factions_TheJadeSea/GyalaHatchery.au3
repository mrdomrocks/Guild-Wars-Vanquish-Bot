Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutGyalaHatchery()
        Local $aGoOutRoute[2][2] = [ [9177, -20845] _
                , [8500, -19800] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "GyalaHatchery exit ")
EndFunc

Func VQGyalaHatchery()
    If GetMapID() <> $GyalaHatchery_Map And GetMapID() <> $GyalaHatchery_Outpost  Then TravelTo($GyalaHatchery_Outpost)   
