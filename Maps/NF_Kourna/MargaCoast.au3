Func GoOutMargaCoast()
        Local $aGoOutRoute[4][2] = [ [-3144, 4512] _
                , [-4829, 4923] _
                , [-4911, 4913] _
                , [-4950, 4913] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "MargaCoast exit ")
EndFunc

