Func GoOutMargaCoast()
        Local $aGoOutRoute[4][2] = [ [-3144, 4512] _
                , [-4829, 4923] _
                , [-4911, 4913] _
                , [-4950, 4913] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "MargaCoast exit ")
EndFunc

Func VQMargaCoast()
    If GetMapID() <> $MargaCoast_Map And GetMapID() <> $MargaCoast_Outpost  Then TravelTo($MargaCoast_Outpost)   
    If GetMapID() = $MargaCoast_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $MargaCoast_Map Then    
		




		
		GoNearestNPCToCoords(19917, -16160)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Kourna_MargaCoastRoute01)
		
		GoNearestNPCToCoords(2324, -4866)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Kourna_MargaCoastRoute02)
		
		GoNearestNPCToCoords(-16695, -2723)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		_Vanquisher_RunVanquishRoute($aNF_Kourna_MargaCoastRoute03)
		
		GoNearestNPCToCoords(10417, 9560)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
		Sleep(1000)
		Sleep(20000)
		_Vanquisher_RunVanquishRoute($aNF_Kourna_MargaCoastRoute04)
		
		_Vanquisher_RunVanquishRoute($aNF_Kourna_MargaCoastRoute05)
		
