Func GoOutTheFloodplainOfMahnkelon()
        Local $aGoOutRoute[3][2] = [ [2369, 3332] _
                , [4406, 4058] _
                , [4800, 4600] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "TheFloodplainOfMahnkelon exit ")
EndFunc

