#include <Array.au3>
Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutBahdokCaverns()
        Local $aGoOutRoute[1][2] = [ [-13756, -11190] ]

        _Vanquisher_RunPathfinderRoute($aGoOutRoute, $vqrange, "BahdokCaverns exit ")
        GoNearestNPCToCoords(-13647, -10442)
        Sleep(1000)
        Dialog(0x00000081)
        Dialog(0x00000084)
        WaitForLoad()
EndFunc

