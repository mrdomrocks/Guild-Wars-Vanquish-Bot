Func GoOutBahdokCaverns()
        Local $aGoOutRoute[1][2] = [ [-13756, -11190] _
]

        _Vanquisher_RunPathfinderRoute($aGoOutRoute, $vqrange, "BahdokCaverns exit ")
        GoNearestNPCToCoords(-13647, -10442)
        Sleep(1000)
        Dialog(0x00000081)
        Dialog(0x00000084)
         WaitMapLoading($BahdokCaverns_Map, 30000)
EndFunc

Func VQBahdokCaverns()
    If GetMapID() <> $BahdokCaverns_Map And GetMapID() <> $BahdokCaverns_Outpost  Then TravelTo($BahdokCaverns_Outpost)   
