Func GoOutTuraisProcession()
        Local $aGoOutRoute[2][2] = [ [26313, 16414] _
                , [26250, 16700] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "TuraisProcession exit ")
EndFunc

