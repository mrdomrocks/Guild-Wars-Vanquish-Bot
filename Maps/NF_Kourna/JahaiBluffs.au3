Func GoOutJahaiBluffs()
        Local $aGoOutRoute[3][2] = [ [-2596, 2279] _
                , [-4807, 4228] _
                , [-4950, 4400] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "JahaiBluffs exit ")
EndFunc

