Func GoOutDejarinEstate()
        Local $aGoOutRoute[3][2] = [ [3715, 2181] _
                , [4451, 3557] _
                , [4550, 3710] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "DejarinEstate exit ")
EndFunc

