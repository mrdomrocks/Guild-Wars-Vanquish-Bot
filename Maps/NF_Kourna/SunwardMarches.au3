Func GoOutSunwardMarches()
        Local $aGoOutRoute[2][2] = [ [23271, 14344] _
                , [23000, 14100] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "SunwardMarches exit ")
EndFunc

