#include <Array.au3>
Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutBarbarousShore()
        Local $aGoOutRoute[2][2] = [ [-14174, 18358] _
                , [-13900, 18250] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "BarbarousShore exit ")
EndFunc

