        Local $aGoOutRoute[5][2] = [ [-470, -3677] _
                , [2061, -3136] _
                , [2522, 440] _
                , [4316, 811] _
                , [4400, 837] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "ArkjokWard exit ")
EndFunc

Func VQArkjokWard()
    If GetMapID() <> $ArkjokWard_Map And GetMapID() <> $ArkjokWard_Outpost  Then TravelTo($ArkjokWard_Outpost)   
    If GetMapID() = $ArkjokWard_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $ArkjokWard_Map Then    
		



		
			
		GoNearestNPCToCoords(-17266, -12589)
		Sleep(1000)
		Dialog(0x00000084)
		Dialog(0x00000085)
