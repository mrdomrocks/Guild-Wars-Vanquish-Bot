Func GoOutArkjokWard()
        Local $aGoOutRoute[5][2] = [ [-470, -3677] _
                , [2061, -3136] _
                , [2522, 440] _
                , [4316, 811] _
                , [4400, 837] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "ArkjokWard exit ")
EndFunc

