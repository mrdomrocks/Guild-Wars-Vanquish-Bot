Func GoOutSunjiangDistrict()
        Local $aGoOutRoute[3][2] = [ [11102, -18577] _
                , [11737, -19551] _
                , [11737, -20100] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "SunjiangDistrict exit ")
EndFunc

