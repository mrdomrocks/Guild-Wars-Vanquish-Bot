Func GoOutSunjiangDistrict()
        Local $aGoOutRoute[3][2] = [ [11102, -18577] _
                , [11737, -19551] _
                , [11737, -20100] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "SunjiangDistrict exit ")
EndFunc

Func VQSunjiangDistrict()
    If GetMapID() <> $SunjiangDistrict_Map And GetMapID() <> $SunjiangDistrict_Outpost  Then TravelTo($SunjiangDistrict_Outpost)   
    If GetMapID() = $SunjiangDistrict_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $SunjiangDistrict_Map Then    


		_Vanquisher_RunVanquishRoute($aFactions_KainengCity_SunjiangDistrictRoute01)
      		_Vanquisher_RunVanquishRoute($aFactions_KainengCity_SunjiangDistrictRoute02)
		
    EndIf
EndFunc