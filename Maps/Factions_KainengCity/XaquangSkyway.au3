Global $vqrange = 1450
Global $ActionCounter = 1
Func GoOutXaquangSkyway()
        Local $aGoOutRoute[3][2] = [ [6759, -13421] _
                , [6425, -13162] _
                , [6250, -12900] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "XaquangSkyway exit ")
EndFunc

