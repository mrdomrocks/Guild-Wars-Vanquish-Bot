Func GoOutTahnnakiTemple()
        Local $aGoOutRoute[2][2] = [ [2742.42, -16465.20] _
                , [2741.71, -16025.93] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "TahnnakiTemple exit ")
EndFunc

