Func GoOutWajjunBazaar()
        Local $aGoOutRoute[4][2] = [ [12772, 16449] _
                , [11677, 15441] _
                , [11626, 15390] _
                , [11526, 15290] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "WajjunBazaar exit ")
EndFunc

