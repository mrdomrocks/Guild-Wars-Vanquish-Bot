Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutRaisuPalace()
        Local $aGoOutRoute[4][2] = [ [-10609, -1451] _
                , [-10472, 1289] _
                , [-9653, 2457] _
                , [-9653, 2757] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "RaisuPalace exit ")
EndFunc

