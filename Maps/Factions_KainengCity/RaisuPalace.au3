Func GoOutRaisuPalace()
        Local $aGoOutRoute[4][2] = [ [-10609, -1451] _
                , [-10472, 1289] _
                , [-9653, 2457] _
                , [-9653, 2757] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "RaisuPalace exit ")
EndFunc

Func VQRaisuPalace()
    If GetMapID() <> $RaisuPalace_Map And GetMapID() <> $RaisuPalace_Outpost  Then TravelTo($RaisuPalace_Outpost)   
    If GetMapID() = $RaisuPalace_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $RaisuPalace_Map Then    

		
		_Vanquisher_RunVanquishRoute($aFactions_KainengCity_RaisuPalaceRoute01)
      		_Vanquisher_RunVanquishRoute($aFactions_KainengCity_RaisuPalaceRoute02)
		
    EndIf
EndFunc