Global $vqrange = 1450
Global $ActionCounter = 1

Func GoOutPongmeiValley()
        Local $aGoOutRoute[3][2] = [ [-12095, 12430] _
                , [-13340, 11692] _
                , [-13351, 11081] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "PongmeiValley exit ")
EndFunc

