Func GoOutShenzunTunnels()
        Local $aGoOutRoute[4][2] = [ [-14603, 14336] _
                , [-16087, 16510] _
                , [-17399, 16601] _
                , [-17699, 16601] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "ShenzunTunnels exit ")
EndFunc

