Func GoOutNahpuiQuarter()
        Local $aGoOutRoute[2][2] = [ [7574, -16106] _
                , [7400, -17000] _
                ]

        _Vanquisher_RunPathfinderPortalRoute($aGoOutRoute, $vqrange, "NahpuiQuarter exit ")
EndFunc

Func VQNahpuiQuarter()
    If GetMapID() <> $NahpuiQuarter_Map And GetMapID() <> $NahpuiQuarter_Outpost  Then TravelTo($NahpuiQuarter_Outpost)   
    If GetMapID() = $NahpuiQuarter_Outpost then
       GoOut() 
      
    EndIf

	If GetMapID() = $NahpuiQuarter_Map Then    


		_Vanquisher_RunVanquishRoute($aFactions_KainengCity_NahpuiQuarterRoute01)
      		_Vanquisher_RunVanquishRoute($aFactions_KainengCity_NahpuiQuarterRoute02)
		
    EndIf
EndFunc